{
  "version": 2,

  // ─── BUILD SETTINGS ────────────────────────────────────────────────────────
  // buildCommand: Install client deps then build the Vite SPA
  "buildCommand": "npm install --prefix client && npm run build --prefix client",
  // outputDirectory: Vite outputs to client/dist/ after build
  "outputDirectory": "client/dist",
  // installCommand: Install root-level deps (for api/index.js serverless function)
  "installCommand": "npm install",
  // framework: null = Vercel auto-detects nothing, we control everything manually
  "framework": null,

  // ─── RESPONSE HEADERS ──────────────────────────────────────────────────────
  // PERF: Aggressive caching for static assets with content-hash filenames.
  // Because Vite appends [hash] to every asset, URLs change on every deploy.
  // This means we can safely cache them for 1 full year (31,536,000 seconds).
  // immutable = browser will NEVER revalidate — zero network round-trips on repeat visits.
  "headers": [
    {
      // Vite JS/CSS chunks — all have content-hash filenames, safe for 1y cache
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      // WebP/JPG/PNG image assets — static per deployment, safe for 1y cache
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  // ─── URL ROUTING ───────────────────────────────────────────────────────────
  // ROUTING ORDER: Vercel processes rewrites top-to-bottom, first match wins.
  //
  // Rule 1: /api/** → Express serverless function (backend API calls)
  // Rule 2: /uploads/** → Express serverless function (media uploads)
  // Rule 3: /** → index.html (SPA fallback — enables React Router navigation)
  //           Without this, hard-refreshing /about or /projects returns 404.
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
